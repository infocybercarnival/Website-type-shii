# Copy to .env for LOCAL dev. NEVER commit .env.
#
# On Render, don't upload this file — set each of these as a dashboard
# Environment Variable instead: Render dashboard -> your service ->
# Environment -> Add Environment Variable. Same idea on Vercel for the
# frontend's NEXT_PUBLIC_API_URL (see frontend/.env.example).

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "development" locally, "production" on Render.
FLASK_ENV=development

# Comma-separated list of frontend origins allowed to call the public API.
# Put your real Vercel URL(s) here in production, e.g.:
# ALLOWED_ORIGINS=https://cybercarnival.vercel.app,https://cybercarnival.in
ALLOWED_ORIGINS=http://localhost:3000

# Storage backend for rate-limit counters. Use redis:// in production with >1 worker process.
RATELIMIT_STORAGE_URI=memory://

# --- Database (Postgres / Supabase) --------------------------------------------
# Simplest: paste Supabase's full connection string here (Project Settings ->
# Database -> Connection string -> URI). Use the "Transaction pooler" one for
# Render (session pooler doesn't play well with serverless-style restarts).
# Example shape:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Only used as a fallback if DATABASE_URL above is left blank.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybercarnival
DB_USER=postgres
DB_PASSWORD=

EMAIL_DEV_MODE=true
EMAIL_SMTP_URL=smtp.gmail.com:587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=CyberCarnival

# One-time bootstrap admin account, used only by seed_admin.py. Remove after first run.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
