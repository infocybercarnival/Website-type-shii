# Copy to .env and fill in real values. NEVER commit .env.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" on the real server. Enables HTTPS-only cookies, HSTS, hides debug info.
FLASK_ENV=development

# Comma-separated list of frontend origins allowed to call the public API.
ALLOWED_ORIGINS=http://localhost:3000

# Storage backend for rate-limit counters. Use redis:// in production with >1 worker process.
RATELIMIT_STORAGE_URI=memory://

# --- Database (MySQL, local for now) ------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cybercarnival
DB_USER=root
DB_PASSWORD=your-local-database-password


EMAIL_DEV_MODE=true
EMAIL_SMTP_URL=smtp.gmail.com:587
EMAIL_SMTP_USER=info.cybercarnival@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=info.cybercarnival@gmail.com
EMAIL_FROM_NAME=CyberCarnival

# One-time bootstrap admin account, used only by seed_admin.py. Remove after first run.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
