# Set these on Render, NOT as an uploaded file:
# Render dashboard -> your backend service -> Environment -> Add Environment Variable
# (one variable per line below). This file is just so you have everything in
# one place to copy from — don't commit it, don't upload it as-is.

SECRET_KEY=477eac2930d162d7f21d1317007f5dc913be67495adffaa23f07f72b293065fa

FLASK_ENV=production

# Replace with your actual Vercel domain(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://your-project.vercel.app

RATELIMIT_STORAGE_URI=memory://

# Paste your Supabase connection string here — Project Settings -> Database ->
# Connection string -> URI -> "Transaction pooler" (port 6543, works better
# than the direct/session pooler on Render's short-lived connections).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_SUPABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

EMAIL_DEV_MODE=False
EMAIL_SMTP_URL=smtp.gmail.com:587
