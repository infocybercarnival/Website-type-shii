{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && pnpm install --frozen-lockfile && pnpm build",
  "outputDirectory": "frontend/out",
  "installCommand": "cd frontend && pnpm install --frozen-lockfile",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,backend/static/**,backend/logs/**,backend/data/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/admin/:path*", "destination": "/api/index.py" },
    { "source": "/uploads/:path*", "destination": "/api/index.py" }
  ]
}
