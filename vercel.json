{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && corepack pnpm install --frozen-lockfile && corepack pnpm build",
  "outputDirectory": "frontend/out",
  "installCommand": "cd frontend && corepack pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/admin/:path*", "destination": "/api/index.py" },
    { "source": "/uploads/:path*", "destination": "/api/index.py" }
  ]
}
