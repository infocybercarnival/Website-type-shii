# Local dev (pnpm dev, frontend on :3000 talking to backend on :5000):
# copy this to .env.development.local, or just use the existing
# .env.development in this folder.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Vercel (production): set this in the dashboard, NOT in a committed file —
# Vercel project -> Settings -> Environment Variables -> add
# NEXT_PUBLIC_API_URL = your Render backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://cybercarnival-backend.onrender.com
#
# Frontend is a static export (output: 'export'), so this value gets baked
# into the JS bundle AT BUILD TIME. If you change it, you must trigger a
# new Vercel deploy — restarting/refreshing alone won't pick it up.
